# Copy to .env and fill in real values. Do NOT commit .env.

# MySQL
DB_HOST=localhost
DB_PORT=3306
DB_NAME=sales_crm
DB_USER=root
DB_PASSWORD=

# App
PORT=4000
JWT_EXPIRES_IN=8h

# Secret key that signs sign-in passes. It must be long, random and private, and never shared.
# Do not type one yourself: run  npm run new-secret  to create it. The server will not start
# without a proper one. Changing it only signs everyone out; no data is affected.
JWT_SECRET=

# Websites allowed to use this server from a browser, comma-separated, for example
# https://crm.yourcompany.com . While developing, pages on this computer are always allowed.
# Required when NODE_ENV=production.
CORS_ORIGINS=

# File uploads (relative to backend/)
UPLOAD_DIR=uploads

# First Owner login, created by  npm run seed  when the users table is empty
SEED_ADMIN_EMAIL=admin@yourcompany.com
SEED_ADMIN_PASSWORD=changeme
SEED_ADMIN_NAME=Owner

# 'development' on your own computer, 'production' on a hosted site.
NODE_ENV=development
